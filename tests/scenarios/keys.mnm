# KEYS: the keys play the track; recording while playing and step entry while stopped
wait 300
tap SEQ
expect keys 1
tapkey b3
expect track 0
turn SELECT 3
expect track 3
# play a note: track 4 (SAW) sounds
peakreset
key 7 down
wait 200
expect peak_db_min -30
key 7 up
expect notes3 1
tap OCT+
expect octave 1
tap OCT-
tap OCT-
expect octave -1
tap OCT+
# step entry: REC, stopped; every key goes on the next step
tap REC
expect rec 1
# clear track 4 first (GRID: COPY held + PASTE)
tap SEQ
key b9 down
tapkey b10
key b9 up
tap SEQ
tapkey 0
tapkey 2
tapkey 4
expect trig3_0 1
expect note3_0 53
expect note3_1 55
expect note3_2 57
expect trig3_3 0
shot stepentry.png
# live recording: playing, a note goes on the step it falls on (PLAY acts on the press: 80 ms + 560 =
# 5.1 steps; and one later in a step goes on the next one)
tap PLAY
wait 560
tapkey 12
wait 50
tapkey 14
wait 200
expect trig3_5 1
expect note3_5 65
expect trig3_6 1
expect note3_6 67
# the knobs as locks on the trigs, playing with REC
tap ENV
wait 1400
tap REC
expect rec 0
tap PLAY
expect dropped 0
